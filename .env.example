# ==========================================
# EARLYCLAIM ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=5000

# Client URL (for CORS & notification links)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# JWT Secret for Authentication
JWT_SECRET=earlyclaim_super_secret_jwt_key_2026_change_in_production

# Optional MongoDB URI (If left blank, EarlyClaim uses persistent JSON / file-backed database)
MONGODB_URI=

# Paystack API Keys (Test keys by default)
PAYSTACK_SECRET_KEY=sk_test_earlyclaim_demo_key
PAYSTACK_PUBLIC_KEY=pk_test_earlyclaim_demo_key

# Support & Business Settings
SUPPORT_EMAIL=dentehsarpong87@gmail.com
SUPPORT_PHONE=0530279271
SUPPORT_WHATSAPP=+233530279271
BRAND_FOOTER="© 2026 TECH ON DEMAND. All rights reserved."

# Currency Conversion (1 USD to GHS)
USD_TO_GHS_RATE=15.50

# ------------------------------------------
# NOTIFICATION & ALERT CONFIGURATION
# ------------------------------------------

# Admin Email Alert Recipient (defaults to dentehsarpong87@gmail.com)
ADMIN_ALERT_EMAIL=dentehsarpong87@gmail.com

# SMTP Email Provider Configuration (e.g., SendGrid, Mailgun, Amazon SES, or Gmail SMTP)
# Leave blank to run in console simulation mode
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=EarlyClaim <notifications@earlyclaim.com>

# Optional SMS / WhatsApp Alert Configuration
# Set to 'true' to activate delivery notifications to customer phones
ENABLE_SMS=false
ENABLE_WHATSAPP=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------
# IMAGE STORAGE CONFIGURATION (Cloudinary / S3)
# ------------------------------------------

# Optional: Cloudinary configuration for product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AWS S3 configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
